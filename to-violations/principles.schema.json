{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "to-violations-principles",
  "title": "To-Violations Principles Catalog",
  "type": "object",
  "required": ["principles"],
  "properties": {
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "severity", "artifacts", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_.-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["must", "should", "may"]
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "agent-instruction",
                "code",
                "diagnose",
                "handoff",
                "plan",
                "PRD",
                "skill",
                "spec"
              ]
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
