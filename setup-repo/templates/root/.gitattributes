# Normalize line endings for text files
* text=auto

# Force LF for markdown, JSON, Python scripts
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# PowerShell scripts: CRLF on Windows for native execution
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.mp4 binary
*.avi binary
*.mov binary
*.mp3 binary
*.ogg binary
*.wav binary
*.sqlite binary
*.sqlite3 binary
